transform crCenPos:
    zoom 0.53
    xalign 0.5
    yalign 1.0
    ypos 1.0
    yoffset 380

transform crSitCenPos:
    zoom 0.53
    xalign 0.5
    yalign 1.0
    ypos 1.0
    yoffset 520

transform crSitDown:
    zoom 0.53
    xalign 0.5
    yalign 1.0
    ypos 1.0
    yoffset 380
    easein  0.15 yoffset 360   # tiny lift before sitting
    easeout 0.50 yoffset 540   # drop down
    easein  0.15 yoffset 520   # settle, ends exactly on crSitCenPos

transform crLPos:
